# -------------------------------------------------------
# Copy this file to .env.local and fill in the values.
# Run `npx convex dev` to get NEXT_PUBLIC_CONVEX_URL and
# to set CONVEX_AUTH_SECRET automatically.
# -------------------------------------------------------

# Filled automatically by `npx convex dev` (from convex.json)
NEXT_PUBLIC_CONVEX_URL=https://<your-deployment>.convex.cloud

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Or set automatically by `npx convex env set AUTH_SECRET <value>` on the Convex dashboard
CONVEX_AUTH_SECRET=

# (Optional) Used by Convex Auth for email verification links
SITE_URL=http://localhost:3000
